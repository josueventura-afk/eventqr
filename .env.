# --- Aplicación ---
APP_TITLE=EventQR
APP_PORT=8080
STORAGE_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Base de datos: Supabase ---
# Dashboard de Supabase > Connect. Acepta postgres:// y postgresql://.
# Si la contraseña tiene caracteres especiales (@ # / :) codifícala en formato URL.

# Opción recomendada (servidor persistente, IPv4): Session pooler, puerto 5432
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Conexión directa (solo si tu servidor soporta IPv6):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Transaction pooler (serverless), puerto 6543: activa también DB_USE_NULLPOOL=true
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# true = sin pool propio de SQLAlchemy (recomendado con el pooler en modo transacción)
DB_USE_NULLPOOL=false
